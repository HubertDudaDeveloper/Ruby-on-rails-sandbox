<div id="<%= dom_id post %>">
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= post.description %>
  </p>

  <p>
    <strong>Thumnail url:</strong>
    <%= post.thumnail_url %>
  </p>

  <p>
    <strong>Video url:</strong>
    <%= post.video_url %>
  </p>

  <p>
    <strong>Role:</strong>
    <%= post.role %>
  </p>

</div>
